NOTES_IMAGE=notes-organizations-web:local
NOTES_BIND=127.0.0.1
NOTES_HTTP_PORT=8080
SITE_ADDRESS=notes.example.org
AUTH_COOKIE_SECURE=true
# Cloudflare Tunnel (profile "cloudflare"): the token from Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
# Who may create an account: open | invite | closed (see docs/DOCKER-WEB.md)
NOTES_REGISTRATION=open
NOTES_REGISTER_PER_HOUR=10
NOTES_MAX_VAULTS=20
# Attachments: largest file in MB (plaintext; the ciphertext adds 32 bytes plus 17 bytes per MiB)
NOTES_FILE_MAX_MB=100
# Attachments: space per shared vault in MB, trash included
NOTES_VAULT_FILES_MB=2048
# Attachments: days a deleted file stays in the trash before the node removes it
NOTES_FILE_TRASH_DAYS=30
# Attachments: hours before an upload that never finished is removed
NOTES_UPLOAD_STALE_HOURS=24
# Attachments: uploads one person may run at once in one vault
NOTES_MAX_PARALLEL_UPLOADS=4
# Secret shared by notes-node and SeaweedFS (signed requests to the file store). 64 hex chars;
# scripts/wdrozenie.sh generates it when missing. Never share it or put it in the browser.
SEAWEEDFS_JWT_KEY=
