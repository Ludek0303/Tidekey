{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "typeRoots": ["../ui/node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": { "yjs": ["./node_modules/yjs"] }
  },
  "include": ["src", "test", "build.mjs", "vitest.config.ts", "../ui/src/vite-env.d.ts", "../ui/src/voice/opfs.d.ts"]
}
