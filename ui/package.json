{
  "name": "notes-organizations-ui",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser prototype UI for the notes app",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "wasm": "bash scripts/build-wasm.sh",
    "wasm:preview": "bash scripts/build-preview-wasm.sh",
    "prebuild": "node -e \"for (const f of ['app', 'worker', 'preview', 'preview-worker']) require('fs').rmSync('../scripts/licencje/.cache/ui-' + f + '.json', { force: true })\"",
    "build": "npm run wasm && npm run wasm:preview && tsc --noEmit && vite build && vite build -c vite.preview.config.ts",
    "build:preview": "npm run wasm:preview && vite build -c vite.preview.config.ts",
    "preview:watch": "vite build -c vite.preview.config.ts --watch",
    "pretest": "npm run wasm",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@loaders.gl/core": "4.5.4",
    "@loaders.gl/las": "4.5.4",
    "@loaders.gl/pcd": "4.5.4",
    "@loaders.gl/ply": "4.5.4",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "ag-psd": "34.2.1",
    "d3-force": "^3.0.0",
    "docx-preview": "0.4.1",
    "draco3d": "1.5.9",
    "dxf-viewer": "1.0.51",
    "fflate": "0.8.3",
    "jszip": "3.10.2",
    "libheif-js": "1.23.5",
    "libsodium-wrappers": "0.8.4",
    "lucide": "^1.59.0",
    "online-3d-viewer": "0.18.0",
    "onnxruntime-web": "1.24.1",
    "opentype.js": "2.0.0",
    "parakeet.js": "1.4.4",
    "pdfjs-dist": "6.5.438",
    "pptx-browser": "4.1.5",
    "rhino3dm": "8.35.0",
    "roboto-fontface": "0.10.0",
    "three": "0.186.1",
    "utif": "3.1.0",
    "web-ifc": "0.0.79",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "y-codemirror.next": "^0.3.6",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.5",
    "@types/three": "0.186.0",
    "jsdom": "^30.1.3",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
