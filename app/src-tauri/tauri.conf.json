{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notatki Organizacje",
  "version": "0.1.0",
  "identifier": "pl.notes.organizations",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [
      {
        "title": "Notatki Organizacje",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "copyright": "Copyright (c) 2026 Stanisław Ludwicki",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    }
  }
}
